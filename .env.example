# Copy to .env and fill in. The .env file is gitignored.

# Base URL of the deployed proxy that talks to OpenAI (see /api/chat.ts).
# No trailing slash. e.g. https://your-project.vercel.app
EXPO_PUBLIC_API_URL=

# NOTE: The OpenAI key is NOT set here. It belongs only on the server —
# add it to your Vercel project env as OPENAI_API_KEY (never EXPO_PUBLIC_*,
# which would embed it in the shipped app bundle).
